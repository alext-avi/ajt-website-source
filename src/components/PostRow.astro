---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { formatDate, readingTime } from '../lib/content';
interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
---

<article class="post-row">
  <div class="post-date">
    <time datetime={post.data.date.toISOString()}>
      {formatDate(post.data.date)}
    </time>
    <span>{readingTime(post.body)} min read</span>
  </div>
  <div class="post-row-main">
    <div class="post-kicker">
      {post.data.category}
      {post.data.linkedinUrl && (
        <span class="muted">
          LinkedIn {post.data.linkedinRepost ? 'commentary' : 'post'}
        </span>
      )}
      {post.data.example && <span class="example-label">Example article</span>}
      {post.data.draft && <span class="status-label">Draft</span>}
    </div>
    <h3>
      <a href={`/writing/${post.id}/`}>{post.data.title}</a>
    </h3>
    <p>{post.data.summary}</p>
    {post.data.image && (
      <img
        class="post-preview"
        src={post.data.image}
        alt={post.data.imageAlt ?? ''}
        width="320"
        height="200"
        loading="lazy"
        decoding="async"
      />
    )}
  </div>
  <a
    class="circle-link"
    href={`/writing/${post.id}/`}
    aria-label={`Read ${post.data.title}`}
  >
    <Icon name="external" />
  </a>
</article>
