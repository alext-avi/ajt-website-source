---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import Icon from '../../components/Icon.astro';
import ContactBand from '../../components/ContactBand.astro';
import { getTalks, formatDate } from '../../lib/content';
import { contactHref } from '../../lib/site';
const talks = await getTalks();
const confirmed = talks.filter((t) => t.data.status !== 'proposed');
const proposals = talks.filter((t) => t.data.status === 'proposed');
---

<Base
  title="Speaking"
  description="Talks and practical conversations on applied AI, agentic development, MCP, engineering leadership, and building software people can rely on."
>
  <PageIntro
    eyebrow="On stage, in practice"
    title="Ideas with something to stand on."
    description="Practical talks for people who build software, lead teams, and have to make technology work in the real world."
  />
  <section class="shell page-body speaking-grid">
    <div>
      <p class="eyebrow mb-6">Talks & appearances</p>
      {confirmed.map((talk) => (
        <article class="talk-card">
          <div class="talk-label">
            <span>
              {talk.data.status === 'past' ? 'PAST SESSION' : 'UPCOMING'}
              {talk.data.draft ? ' / DRAFT' : ''}
            </span>
            {talk.data.date && (
              <time datetime={talk.data.date.toISOString()}>
                {formatDate(talk.data.date)}
              </time>
            )}
          </div>
          <h2 class="!text-[27px] !leading-[1.3]">
            <a href={`/speaking/${talk.id}/`}>{talk.data.title}</a>
          </h2>
          <p>{talk.data.summary}</p>
          <div class="talk-bottom">
            <span>
              {talk.data.event}
              {talk.data.location && <br />}
              {talk.data.location}
            </span>
            <a
              href={`/speaking/${talk.id}/`}
              aria-label={`View ${talk.data.title}`}
            >
              <Icon name="external" size={21} />
            </a>
          </div>
        </article>
      ))}
      {!confirmed.length && (
        <div class="empty-state">
          <h2>Let’s bring a useful conversation to your event.</h2>
          <p>
            My focus is applied AI, agentic development, software architecture,
            and engineering leadership.
          </p>
        </div>
      )}
      {proposals.length > 0 && (
        <div class="mt-10">
          <p class="eyebrow mb-6">Available session topics</p>
          {proposals.map((talk) => (
            <article class="talk-card">
              <div class="talk-label">
                <span>PROPOSED TOPIC · NO EVENT CONFIRMED</span>
              </div>
              <h2 class="!text-[25px] !leading-[1.3]">
                <a href={`/speaking/${talk.id}/`}>{talk.data.title}</a>
              </h2>
              <p>{talk.data.summary}</p>
              <a class="text-link mt-6" href={`/speaking/${talk.id}/`}>
                Explore this session <Icon name="external" size={16} />
              </a>
            </article>
          ))}
        </div>
      )}
    </div>
    <aside class="speaking-aside">
      <p class="eyebrow mb-4">For organizers</p>
      <h2>A useful hour. Or ten minutes.</h2>
      <p>
        I’m interested in conversations that help people make better decisions,
        whether that is a conference session, a technical meetup, or a workshop
        with an engineering team.
      </p>
      <p class="mt-4">
        Tell me about the audience, format, dates, and what you want people to
        leave understanding.
      </p>
      <a class="button" href={contactHref('Speaking inquiry')}>
        Discuss a speaking opportunity <Icon size={17} />
      </a>
      <div class="topic-list">
        <span>Applied AI</span>
        <span>MCP & agent systems</span>
        <span>Engineering leadership</span>
        <span>Agentic SDLC</span>
        <span>AI for business workflows</span>
        <span>Software architecture</span>
      </div>
      <div class="speaker-bio">
        <h3>A short introduction</h3>
        <p>
          Alexander Thomas is CTO at Applied Visions, a software builder and
          engineering leader with nearly 20 years of experience. His work spans
          practical AI, software modernization, cloud architecture, and product
          delivery. He also serves as CTO and Product Owner at MealTrack and
          holds a BS in Computer Science from Stony Brook University.
        </p>
      </div>
    </aside>
  </section>
  <ContactBand
    title="Bring the conversation to your team."
    description="Have an audience and a question worth exploring? Let’s work out the right format."
  />
</Base>
