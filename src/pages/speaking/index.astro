---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ContactBand from '../../components/ContactBand.astro';
import { speakingPhotos } from '../../data/speaking-photos';
import { getTalks, formatDate } from '../../lib/content';
import { contactHref } from '../../lib/site';
const talks = await getTalks();
const confirmed = talks.filter((t) => t.data.status !== 'proposed');
const proposals = talks.filter((t) => t.data.status === 'proposed');
---

<Base
  title="Speaking"
  description="Talks and practical conversations on applied AI, agentic development, MCP, engineering leadership, and building software people can rely on."
>
  <section class="shell speaking-hero" aria-labelledby="speaking-title">
    <div class="speaking-hero-scene">
      <img
        class="speaking-hero-image"
        src={speakingPhotos.stage.src}
        alt={speakingPhotos.stage.alt}
        width={speakingPhotos.stage.width}
        height={speakingPhotos.stage.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="speaking-intro">
        <p class="eyebrow">
          <span class="small-line"></span>Speaking
        </p>
        <h1 id="speaking-title">Ideas with something to stand on.</h1>
        <p class="page-description">
          Practical talks for people who build software, lead teams, and have to
          make technology work in the real world.
        </p>
      </div>
    </div>
    <p class="speaking-photo-credit">
      All Things Open 2026 ·{' '}
      <a href="/speaking/your-next-power-user/">
        Your Next Power User Won’t Learn Your UI
      </a>
    </p>
  </section>
  <section class="shell page-body speaking-grid">
    <div>
      <p class="eyebrow mb-6">Talks & appearances</p>
      {confirmed.map((talk) => (
        <article class="talk-card">
          <div class="talk-label">
            <span>
              {talk.data.status === 'past' ? 'PAST SESSION' : 'UPCOMING'}
              {talk.data.draft ? ' / DRAFT' : ''}
            </span>
            {talk.data.date && (
              <time datetime={talk.data.date.toISOString()}>
                {formatDate(talk.data.date)}
              </time>
            )}
          </div>
          <h2 class="!text-[27px] !leading-[1.3]">
            <a href={`/speaking/${talk.id}/`}>{talk.data.title}</a>
          </h2>
          <p>{talk.data.summary}</p>
          <div class="talk-bottom">
            <span>
              {talk.data.event}
              {talk.data.location && <br />}
              {talk.data.location}
            </span>
            <a
              href={`/speaking/${talk.id}/`}
              aria-label={`View ${talk.data.title}`}
            >
              <Icon name="external" size={21} />
            </a>
          </div>
        </article>
      ))}
      {!confirmed.length && (
        <div class="empty-state">
          <h2>Let’s bring a useful conversation to your event.</h2>
          <p>
            My focus is applied AI, agentic development, software architecture,
            and engineering leadership.
          </p>
        </div>
      )}
      {proposals.length > 0 && (
        <div class="mt-10">
          <p class="eyebrow mb-6">Available session topics</p>
          {proposals.map((talk) => (
            <article class="talk-card">
              <div class="talk-label">
                <span>PROPOSED TOPIC · NO EVENT CONFIRMED</span>
              </div>
              <h2 class="!text-[25px] !leading-[1.3]">
                <a href={`/speaking/${talk.id}/`}>{talk.data.title}</a>
              </h2>
              <p>{talk.data.summary}</p>
              <a class="text-link mt-6" href={`/speaking/${talk.id}/`}>
                Explore this session <Icon name="external" size={16} />
              </a>
            </article>
          ))}
        </div>
      )}
    </div>
    <aside class="speaking-aside">
      <p class="eyebrow mb-4">For organizers</p>
      <h2>A useful hour. Or ten minutes.</h2>
      <p>
        I’m interested in conversations that help people make better decisions,
        whether that is a conference session, a technical meetup, or a workshop
        with an engineering team.
      </p>
      <p class="mt-4">
        Tell me about the audience, format, dates, and what you want people to
        leave understanding.
      </p>
      <a class="button" href={contactHref('Speaking inquiry')}>
        Discuss a speaking opportunity <Icon size={17} />
      </a>
      <div class="topic-list">
        <span>Applied AI</span>
        <span>MCP & agent systems</span>
        <span>Engineering leadership</span>
        <span>Agentic SDLC</span>
        <span>AI for business workflows</span>
        <span>Software architecture</span>
      </div>
      <div class="speaker-bio">
        <h3>A short introduction</h3>
        <p>
          Alexander Thomas is CTO at Applied Visions, a software builder and
          engineering leader with nearly 20 years of experience. His work spans
          practical AI, software modernization, cloud architecture, and product
          delivery. He also serves as CTO and Product Owner at MealTrack and
          holds a BS in Computer Science from Stony Brook University.
        </p>
      </div>
    </aside>
  </section>
  <ContactBand
    title="Bring the conversation to your team."
    description="Have an audience and a question worth exploring? Let’s work out the right format."
  />
</Base>

<style>
  .speaking-hero {
    padding-top: 36px;
    padding-bottom: 52px;
  }
  .speaking-hero-scene {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    min-height: 560px;
    border-radius: 6px;
    background: #05080d;
  }
  .speaking-hero-image,
  .speaking-hero-scene::after {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .speaking-hero-image {
    z-index: -2;
    object-fit: cover;
    object-position: center top;
  }
  .speaking-hero-scene::after {
    content: '';
    z-index: -1;
    background: linear-gradient(
      90deg,
      transparent 28%,
      #05080d30 43%,
      #05080dcf 59%,
      #05080deb 100%
    );
    pointer-events: none;
  }
  .speaking-intro {
    grid-column: 2;
    padding: 56px 48px 56px 28px;
  }
  .speaking-intro .eyebrow {
    color: #dfbd79;
  }
  .speaking-intro h1 {
    margin-top: 21px;
    color: #ffffff;
    font-size: clamp(40px, 4.3vw, 58px);
    line-height: 1.15;
    text-wrap: balance;
  }
  .speaking-intro .page-description {
    color: #d1d8e4;
    font-size: 17px;
    line-height: 1.8;
    max-width: 410px;
  }
  .speaking-photo-credit {
    margin-top: 12px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.7;
  }
  .speaking-photo-credit a {
    text-underline-offset: 3px;
  }
  .speaking-photo-credit a:hover {
    text-decoration: underline;
  }
  @media (max-width: 900px) {
    .speaking-hero {
      padding-top: 24px;
      padding-bottom: 40px;
    }
    .speaking-hero-scene {
      display: block;
      min-height: 0;
    }
    .speaking-hero-image {
      position: relative;
      display: block;
      height: auto;
      aspect-ratio: 16 / 9;
      object-position: center top;
      mask-image: linear-gradient(#000000 80%, transparent);
    }
    .speaking-hero-scene::after {
      display: none;
    }
    .speaking-intro {
      padding: 12px 32px 36px;
    }
    .speaking-intro h1 {
      font-size: clamp(36px, 5.5vw, 48px);
      margin-top: 16px;
    }
    .speaking-intro .page-description {
      max-width: 600px;
      font-size: 16px;
      margin-top: 18px;
    }
  }
  @media (max-width: 600px) {
    .speaking-hero-image {
      aspect-ratio: 4 / 3;
      height: auto;
      object-position: 27% top;
    }
    .speaking-intro {
      padding: 8px 24px 30px;
    }
  }
</style>
