---
import { render, type CollectionEntry } from 'astro:content';
import { renderMarkdown } from '../../../mcp/content-render.mjs';
import Base from '../../layouts/Base.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import { getProjects, getPosts } from '../../lib/content';
export async function getStaticPaths() {
  return (await getProjects()).map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}
interface Props {
  project: CollectionEntry<'projects'>;
}
const project =
  Astro.props.project ||
  (await getProjects()).find((item) => item.id === Astro.params.id);
if (!project) return Astro.rewrite('/404/');
const runtimeBody = import.meta.env.AJT_RUNTIME
  ? renderMarkdown(project.body || '')
  : undefined;
const Content = runtimeBody ? undefined : (await render(project)).Content;
const related = (await getPosts()).filter((p) =>
  project.data.relatedArticles.includes(p.id),
);
---

<Base
  title={project.data.title}
  description={project.data.summary}
  noindex={project.data.draft}
>
  <ProjectDetail project={project} related={related}>
    <Fragment set:html={runtimeBody?.html} />
    {Content && <Content />}
  </ProjectDetail>
</Base>
