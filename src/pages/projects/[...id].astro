---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProjectArt from '../../components/ProjectArt.astro';
import ContactBand from '../../components/ContactBand.astro';
import PostRow from '../../components/PostRow.astro';
import { getProjects, getPosts } from '../../lib/content';
export async function getStaticPaths() {
  return (await getProjects()).map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}
interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { Content } = await render(project);
const related = (await getPosts()).filter((p) =>
  project.data.relatedArticles.includes(p.id),
);
---

<Base
  title={project.data.title}
  description={project.data.summary}
  noindex={project.data.draft}
>
  <header class="shell detail-head">
    <a class="breadcrumb" href="/projects/">
      ← All projects
    </a>
    <p class="eyebrow">{project.data.tags.join(' / ')}</p>
    <h1>{project.data.title}</h1>
    <p class="lede">{project.data.summary}</p>
  </header>
  <div class="shell project-detail-art">
    {project.data.image ? (
      <img
        src={project.data.image}
        alt={project.data.imageAlt ?? ''}
        width="1200"
        height="650"
      />
    ) : (
      <ProjectArt kind={project.data.kind} />
    )}
  </div>
  <div class="shell page-body article-grid">
    <div class="article-body">
      {project.data.draft && (
        <p class="preview-note">
          Draft case study for review. Details are unverified and excluded from
          production.
        </p>
      )}
      <article class="prose">
        <Content />
      </article>
      {project.data.outcomes.length > 0 && (
        <section class="project-outcomes mt-9 pt-7">
          <p class="eyebrow mb-4">Selected outcomes</p>
          <ul class="space-y-3 text-sm">
            {project.data.outcomes.map((outcome) => (
              <li class="flex items-start gap-3">
                <span class="mt-1 shrink-0">
                  <Icon name="check" size={17} />
                </span>
                {outcome}
              </li>
            ))}
          </ul>
        </section>
      )}
      {related.length > 0 && (
        <section class="related-section">
          <h2>Related thinking.</h2>
          {related.map((post) => (
            <PostRow post={post} />
          ))}
        </section>
      )}
    </div>
    <aside class="project-facts">
      <h2>My role</h2>
      <p>{project.data.role}</p>
      <h2>Tools & disciplines</h2>
      <div class="tech-list">
        {project.data.technologies.map((t) => (
          <span>{t}</span>
        ))}
      </div>
      {project.data.repository && (
        <a class="text-link" href={project.data.repository}>
          View repository <Icon name="github" size={16} />
        </a>
      )}
      <a class="text-link" href="/contact/">
        Discuss similar work <Icon name="external" size={16} />
      </a>
    </aside>
  </div>
  <ContactBand />
</Base>
