---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostRow from '../components/PostRow.astro';
import ContactBand from '../components/ContactBand.astro';
import { getPosts, getProjects, getTalks } from '../lib/content';
const projects = (await getProjects())
  .filter((p) => p.data.featured)
  .slice(0, 2);
const posts = (await getPosts()).filter((p) => p.data.featured).slice(0, 3);
const talks = (await getTalks()).filter((t) => t.data.featured).slice(0, 1);
---

<Base>
  <section class="shell hero">
    <p class="hero-note">CTO at Applied Visions · North Carolina</p>
    <h1>
      I build software. I lead teams.
      <br />I put AI to work.
    </h1>
    <p class="hero-copy">
      I’m Alex, a software architect and hands-on engineering leader. I help
      teams turn business needs into reliable software.
    </p>
    <div class="hero-actions">
      <a class="button" href="/projects/">
        Explore my work <Icon />
      </a>
      <a class="text-link" href="/about/">
        More about me <Icon size={16} />
      </a>
    </div>
  </section>
  <section class="shell section work-section">
    <div class="section-heading">
      <h2>Selected work</h2>
      <a class="text-link" href="/projects/">
        All projects <Icon size={17} />
      </a>
    </div>
    {projects.length ? (
      <div class="project-grid">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <h3>Case studies are on the way.</h3>
        <p>
          Explore my background in software delivery, architecture, and
          engineering leadership.
        </p>
        <a href="/about/" class="text-link">
          Explore my background <Icon size={16} />
        </a>
      </div>
    )}
  </section>
  <section class="shell section writing-section">
    <div class="section-heading">
      <h2>Writing</h2>
      <a class="text-link" href="/writing/">
        All writing <Icon size={17} />
      </a>
    </div>
    {posts.map((post) => (
      <PostRow post={post} compact />
    ))}
  </section>
  <section class="shell section speaking-section">
    <div class="speaking-copy">
      <h2>Speaking</h2>
      <p>
        Practical conversations about AI, software architecture, and leading
        engineering teams.
      </p>
      <a class="text-link" href="/speaking/">
        Talks & speaking <Icon size={17} />
      </a>
    </div>
    {talks.map((talk) => (
      <article class="talk-card">
        <h3>
          <a href={`/speaking/${talk.id}/`}>{talk.data.title}</a>
        </h3>
        <p>{talk.data.summary}</p>
        <div class="talk-bottom">
          <span>
            {talk.data.event ?? 'For engineering and technology leaders'}
          </span>
          <a
            href={`/speaking/${talk.id}/`}
            aria-label={`Explore ${talk.data.title}`}
          >
            <Icon size={20} />
          </a>
        </div>
      </article>
    ))}
  </section>
  <ContactBand />
</Base>
