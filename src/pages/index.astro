---
import Base from '../layouts/Base.astro';
import SignatureMark from '../components/SignatureMark.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostRow from '../components/PostRow.astro';
import ContactBand from '../components/ContactBand.astro';
import { getPosts, getProjects, getTalks } from '../lib/content';
const projects = (await getProjects())
  .filter((p) => p.data.featured)
  .slice(0, 2);
const posts = (await getPosts()).filter((p) => p.data.featured).slice(0, 3);
const talks = (await getTalks()).filter((t) => t.data.featured).slice(0, 1);
---

<Base>
  <section class="shell hero">
    <div>
      <p class="eyebrow">
        <span class="small-line"></span>CTO · Engineering leader · Builder
      </p>
      <h1>
        I build software.
        <br />I lead teams.
        <br />I put <em>AI to work.</em>
      </h1>
      <p class="hero-copy">
        Nearly 20 years connecting business intent with engineering reality.
        From the architecture to the people who make it work.
      </p>
      <div class="hero-actions">
        <a class="button" href="/projects/">
          Explore my work <Icon />
        </a>
        <a class="text-link" href="/about/">
          A little about me <Icon name="external" size={17} />
        </a>
      </div>
      <p class="hero-note">
        <span class="availability-dot"></span>Currently CTO at Applied Visions ·
        Based in North Carolina
      </p>
    </div>
    <div
      class="hero-visual"
      aria-label="Leadership, software architecture, and applied AI are connected parts of my work."
      role="img"
    >
      <div class="visual-header">
        <span>A PRACTICE, NOT A JOB TITLE</span>
        <span class="visual-status"></span>
      </div>
      <div class="systems-map" aria-hidden="true">
        <svg
          class="systems-lines"
          viewBox="0 0 320 250"
          preserveAspectRatio="none"
          fill="none"
        >
          <path
            d="M70 40V95H160M260 85H225V125H160M90 225V170H160"
            stroke="var(--art-line)"
            stroke-width="1"
          />
          <circle
            cx="160"
            cy="125"
            r="100"
            stroke="var(--art-line)"
            stroke-dasharray="3 5"
          />
        </svg>
        <span class="map-label lead">01 / LEAD PEOPLE</span>
        <span class="map-label build">02 / BUILD SYSTEMS</span>
        <span class="map-label apply">03 / APPLY AI</span>
        <div class="central-node">
          <SignatureMark />
          <span>THINK. BUILD. DELIVER.</span>
        </div>
        <span class="map-small-node a"></span>
        <span class="map-small-node b"></span>
      </div>
      <div class="visual-footer">
        <span>Strategy meets implementation.</span>
        <span>ALWAYS CONNECTED ↗</span>
      </div>
    </div>
  </section>
  <div class="shell credibility">
    <p class="credibility-label">
      Experience that connects
      <br />
      the whole picture.
    </p>
    <div class="stat">
      <strong>19+ years</strong>
      <span>Building and delivering software</span>
    </div>
    <div class="stat">
      <strong>40+ people</strong>
      <span>Cross-functional technical leadership</span>
    </div>
    <div class="stat text">
      <strong>
        Executive perspective.
        <br />
        Hands-on depth.
      </strong>
      <span>One practice, both sides.</span>
    </div>
  </div>
  <section class="shell section intro-section">
    <div>
      <p class="eyebrow">The work behind the title</p>
      <h2>
        Close to the business.
        <br />
        Closer to the build.
      </h2>
    </div>
    <div>
      <p class="intro-text">
        I’m Alex, a software builder by background and temperament. My work sits
        between the decisions a business needs to make and the systems an
        engineering team needs to deliver.
      </p>
      <p class="muted text-sm leading-7">
        I lead technical direction, work through architecture, and stay involved
        in implementation. These days, a lot of that work is helping
        organizations use AI thoughtfully, with clear ownership and a plan for
        what happens after the demo.
      </p>
      <a class="text-link" href="/about/">
        More about my approach <Icon name="external" size={16} />
      </a>
    </div>
  </section>
  <section class="shell section work-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2>Real systems. Real constraints.</h2>
      </div>
      <a class="text-link" href="/projects/">
        View all projects <Icon name="arrow" size={17} />
      </a>
    </div>
    {projects.length ? (
      <div class="project-grid">
        {projects.map((project, index) => (
          <ProjectCard project={project} index={index} />
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <h3>Case studies are on the way.</h3>
        <p>
          In the meantime, explore my background in software delivery,
          architecture, and engineering leadership.
        </p>
        <a href="/about/" class="text-link">
          Explore my background <Icon size={16} />
        </a>
      </div>
    )}
  </section>
  <section class="writing-section">
    <div class="shell section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Notes from the work</p>
          <h2>Ideas worth working through.</h2>
        </div>
        <a class="text-link" href="/writing/">
          All writing <Icon size={17} />
        </a>
      </div>
      {posts.map((post) => (
        <PostRow post={post} />
      ))}
    </div>
  </section>
  <section class="shell section speaking-section">
    <div class="speaking-copy">
      <p class="eyebrow">On stage, in practice</p>
      <h2>
        Useful conversations.
        <br />
        Fewer buzzwords.
      </h2>
      <p>
        I speak about applied AI, agentic development, and the engineering
        choices that matter when software has to work outside the demo.
      </p>
      <a class="text-link" href="/speaking/">
        Talks & speaking <Icon name="external" size={17} />
      </a>
    </div>
    {talks.map((talk) => (
      <article class="talk-card">
        <div class="talk-label">
          <span>
            {talk.data.status === 'past'
              ? 'RECENT TALK'
              : talk.data.status === 'proposed'
                ? 'AVAILABLE TOPIC'
                : 'UPCOMING TALK'}
          </span>
          <Icon name="code" size={17} />
        </div>
        <h3>
          <a href={`/speaking/${talk.id}/`}>{talk.data.title}</a>
        </h3>
        <p>{talk.data.summary}</p>
        <div class="talk-bottom">
          <span>
            {talk.data.event ?? 'For engineering and technology leaders'}
          </span>
          <a
            href={`/speaking/${talk.id}/`}
            aria-label={`Explore ${talk.data.title}`}
          >
            <Icon name="external" size={20} />
          </a>
        </div>
      </article>
    ))}
  </section>
  <ContactBand />
</Base>
