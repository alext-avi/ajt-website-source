---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found" noindex>
  <section class="shell not-found">
    <p class="eyebrow">404 / A small detour</p>
    <h1>This page isn’t here.</h1>
    <p>
      The link may have changed, or the page may still be a draft. There’s
      plenty to explore from the homepage.
    </p>
    <a class="button" href="/">
      Back to the beginning <Icon />
    </a>
  </section>
</Base>
