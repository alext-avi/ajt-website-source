# Canonical origin. Update this when moving to a custom domain.
SITE_URL=https://alexander-thomas.alexander-jt.workers.dev
# Separate deployed release candidate; contains published content and no D1 binding.
STAGING_URL=https://alexander-thomas-staging.alexander-jt.workers.dev
# Optional contact overrides. Blank values use the approved business defaults.
PUBLIC_CONTACT_EMAIL=
