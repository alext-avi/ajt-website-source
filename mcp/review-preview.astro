---
import Base from '../src/layouts/Base.astro';
import PostVideo from '../src/components/PostVideo.astro';
import ProjectDetail from '../src/components/ProjectDetail.astro';
import { formatDate, readingTime, getPosts } from '../src/lib/content';
import { postSchema, projectSchema } from '../src/lib/content-schemas';
import {
  reviewStore,
  reviewState,
  renderPost,
  reviewCollection,
} from './reviews.mjs';
export const prerender = false;
if (Astro.url.hostname !== '127.0.0.1')
  return new Response('Not found', { status: 404 });
let state;
try {
  state = await reviewState(await reviewStore(), Astro.params.ticket);
} catch {
  return new Response('Review not found', { status: 404 });
}
const saved = state.review.post;
const isProject = reviewCollection(saved) === 'projects';
const project = isProject
  ? { id: saved.slug, data: projectSchema.parse(saved.metadata) }
  : undefined;
const post = !isProject
  ? {
      id: saved.slug,
      collection: 'posts' as const,
      data: postSchema.parse(saved.metadata),
      body: saved.body,
    }
  : undefined;
const html = await renderPost(saved.body);
const related = project
  ? (await getPosts()).filter((post) =>
      project.data.relatedArticles.includes(post.id) && !post.data.draft && !post.data.example && post.data.date <= new Date(),
    )
  : [];
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set(
  'Content-Security-Policy',
  "script-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'",
);
---

<Base title={saved.metadata.title} description={saved.metadata.summary} noindex>
  {project && (
    <ProjectDetail project={project} related={related} preview>
      <div set:html={html} />
    </ProjectDetail>
  )}
  {post && (
    <>
      <header class="shell detail-head">
        <p class="eyebrow">{post.data.category}</p>
        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.summary}</p>
        <div class="article-meta">
          <span>By Alexander Thomas</span>
          <span class="dot"></span>
          <time datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date)}
          </time>
          <span class="dot"></span>
          <span>{readingTime(post.body)} min read</span>
        </div>
      </header>
      <div class="shell page-body article-grid">
        <div class="article-body">
          {post.data.image && (
            <img
              src={post.data.image}
              alt={post.data.imageAlt || ''}
              class="article-cover mb-8 rounded"
              width="800"
              height="450"
            />
          )}
          <article class="prose" set:html={html} />
          <PostVideo post={post} />
          <div class="article-tags">
            {post.data.tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>
        </div>
      </div>
    </>
  )}
</Base>
