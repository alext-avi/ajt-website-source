{
  "name": "alexander-thomas-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "dev:github": "astro dev --mode github --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test scripts/*.test.mjs",
    "verify": "npm run check && npm run build && npm test",
    "deploy": "npm run db:pull -- --remote && npm run verify && node scripts/check-deploy.mjs && wrangler deploy",
    "cf:preview": "npm run build && wrangler dev",
    "cf:dry-run": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "db:migrate:local": "wrangler d1 migrations apply CONTENT_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply CONTENT_DB --remote",
    "db:seed": "node scripts/content-db.mjs seed",
    "db:pull": "node scripts/content-db.mjs pull",
    "db:push": "node scripts/content-db.mjs push"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.5",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/react": "^7.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "miniflare@5.20261019.2-beta": {
      "undici": "7.30.1"
    }
  },
  "license": "MIT"
}
