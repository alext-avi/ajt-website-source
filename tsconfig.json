{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "artifacts",
    ".wrangler",
    "playwright-report*/**",
    "test-results*/**"
  ]
}
